# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files, and everything else that carries a credential
#
# Enforced by scripts/check-no-secret-files.mjs, which asks git whether these
# names are covered rather than trusting this file — and requires the answer to
# come from a COMMITTED rule. A pattern living only in ~/.gitignore_global or in
# .git/info/exclude protects one checkout and travels nowhere.
.env*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_dsa
id_ecdsa
id_ed25519
credentials.json
serviceAccount*.json
service-account*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/.vscode

# Project specific
TODOS.md
test-results/
.vercel

# Claude Code internal state — not portable between machines
.claude/

# Playwright-generated artifacts — regenerate locally via screenshots.spec.ts
public/Images/screenshots/

# Local quality-audit artifacts
quality.md
quality-*.md

# Working-state docs — live at ~/Desktop/Coding/docs/portfolio-next/
/MANUAL.md
/TODO.md
/PLAN.md
/drafts/

# Lighthouse CI run artifacts — generated HTML/JSON reports, several MB per run.
# `assertion-results.json` was tracked, so every local `lhci autorun` produced a
# spurious diff on a file nobody reads: CI uploads its own reports to temporary
# public storage and the pass/fail is the workflow's exit code, not this file.
.lighthouseci/

# Generated by resume/build.mjs — the source is resume/resume.json
resume/resume.html
