#!/bin/sh
# SEO guard before a push to main: Vercel deploys main whatever CI says.
# Acts only when the push touches SEO paths. Bypass: git push --no-verify
set -u

VERIFICATION_FILE="public/google5c16a36058a0e9e7.html"
ZERO=0000000000000000000000000000000000000000
EMPTY_TREE=4b825dc642cb6eb9a060e54bf8d69288fbee4904
SEO_SUITES="__tests__/seo-identity.test.ts __tests__/robots.test.ts __tests__/sitemap-freshness.test.ts __tests__/llms-txt-consistency.test.ts __tests__/no-hire-copy.test.ts __tests__/identity-claims.test.ts __tests__/khatago-claims.test.ts __tests__/project-seo.test.tsx"
SEO_PATHSPECS="lib/structured-data.ts lib/profile.ts lib/blog-constants.ts lib/constants.ts lib/blog-data.ts app constants content public/llms.txt public/llms-full.txt public/google5c16a36058a0e9e7.html resume/resume.json"

cd "$(git rev-parse --show-toplevel)" || exit 1

is_seo_path() {
  case "$1" in
    lib/structured-data.ts | lib/profile.ts | lib/blog-constants.ts | lib/constants.ts | lib/blog-data.ts) return 0 ;;
    app/*metadata.ts | app/*layout.tsx | app/*page.tsx | app/robots.ts | app/sitemap.ts) return 0 ;;
    constants/* | content/* | public/llms*.txt | public/google*.html | resume/resume.json) return 0 ;;
  esac
  return 1
}

blocked=0
seo_touched=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] || continue
  [ "$local_sha" = "$ZERO" ] && continue

  if ! git cat-file -e "$local_sha:$VERIFICATION_FILE" 2>/dev/null; then
    echo "pre-push: blocked: this push removes $VERIFICATION_FILE (Search Console verification)." >&2
    blocked=1
  fi

  base="$remote_sha"
  if [ "$base" = "$ZERO" ] || ! git cat-file -e "$base^{commit}" 2>/dev/null; then
    base=$(git rev-parse -q --verify origin/main 2>/dev/null || echo "$EMPTY_TREE")
  fi
  for path in $(git diff --name-only "$base" "$local_sha"); do
    if is_seo_path "$path"; then
      seo_touched=1
      break
    fi
  done
done

if [ "$blocked" -ne 0 ]; then
  echo "pre-push: restore the file, or bypass with git push --no-verify." >&2
  exit 1
fi

[ "$seo_touched" -eq 1 ] || exit 0

# The suites read the working tree, so it must match what is being pushed.
# shellcheck disable=SC2086
dirty=$(git status --porcelain -- $SEO_PATHSPECS)
if [ -n "$dirty" ]; then
  echo "pre-push: blocked: uncommitted changes to SEO paths would be tested instead of the pushed commit:" >&2
  echo "$dirty" >&2
  exit 1
fi

echo "pre-push: SEO paths changed on main; running the SEO suites (bypass: git push --no-verify)." >&2
# shellcheck disable=SC2086
if ! npx --no-install jest --ci $SEO_SUITES; then
  echo "pre-push: blocked: SEO suites failed. Fix them, or bypass with git push --no-verify." >&2
  exit 1
fi
exit 0
